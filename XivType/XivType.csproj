<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.42.0</Version>
    <Author>kuchris</Author>
    <Name>XivType</Name>
    <Punchline>Automatic English typing for Keybound Brawler.</Punchline>
    <Description>Reads Keybound Brawler enemy prompts and types them with keystrokes sent only to the game window, with shortest-prompt or nearest-enemy targeting, background typing and pauses for input-locking casts. English client only.</Description>
    <RepoUrl>https://github.com/kuchris/xivtype</RepoUrl>
    <RepositoryUrl>https://github.com/kuchris/xivtype</RepositoryUrl>
    <IconUrl>https://raw.githubusercontent.com/kuchris/xivtype/0.1.36.0/images/icon.png</IconUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Tags>typing;keybound brawler;gold saucer;automation</Tags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../images/icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
